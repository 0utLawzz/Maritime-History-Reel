# ============================================================
# Environment Variables — copy this to .env (never commit .env)
# On Replit: set these as Secrets in the workspace
# ============================================================

# Required: PostgreSQL connection string
# Replit provides this automatically when a database is provisioned
DATABASE_URL=postgres://user:password@host:5432/dbname

# Required in production: random string for session signing
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Injected automatically by Replit — do not set manually
# PORT=<auto>
# BASE_PATH=<auto>
